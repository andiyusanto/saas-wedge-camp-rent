PORT=3001

# Isi dari Supabase Dashboard > Connect > App Frameworks
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Sengaja TIDAK pakai Secret Key di sini — backend hanya meneruskan JWT
# user (header Authorization) ke Supabase, supaya RLS (owner_id = auth.uid())
# tetap jadi satu-satunya penjaga isolasi antar-vendor. Kalau suatu saat
# butuh operasi server-side yang melewati RLS (mis. cron/admin job), baru
# tambahkan SUPABASE_SECRET_KEY di situ, jangan dipakai untuk request biasa.

# Frontend origin yang diizinkan CORS saat dev
FRONTEND_ORIGIN=http://localhost:5173

# Cloudflare R2 (S3-compatible) — dipakai buat upload foto alat.
# Beda dari Supabase, R2 tidak punya RLS per-user, jadi kredensial ini
# HARUS tetap di backend, tidak boleh dikirim ke frontend sama sekali.
# R2_ACCOUNT_ID     : Cloudflare dashboard > R2 > Account ID
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY : R2 > Manage API Tokens > Create API Token
# R2_BUCKET_NAME    : nama bucket yang dibuat di R2
# R2_PUBLIC_URL     : domain publik bucket (custom domain, atau URL r2.dev bawaan) — TANPA trailing slash
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
