PORT=3001

# Isi dari Supabase Dashboard > Connect > App Frameworks
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Sengaja TIDAK pakai Secret Key di sini — backend hanya meneruskan JWT
# user (header Authorization) ke Supabase, supaya RLS (owner_id = auth.uid())
# tetap jadi satu-satunya penjaga isolasi antar-vendor. Kalau suatu saat
# butuh operasi server-side yang melewati RLS (mis. cron/admin job), baru
# tambahkan SUPABASE_SECRET_KEY di situ, jangan dipakai untuk request biasa.

# Frontend origin yang diizinkan CORS saat dev
FRONTEND_ORIGIN=http://localhost:5173

# URL publik backend ini sendiri (bukan frontend) — dipakai buat
# canonical/og:url di halaman Etalase Online (routes/etalase.ts, GET
# /toko/{slug}) KALAU TOKO_PUBLIC_HOST di bawah belum diisi. Opsional di
# dev lokal (fallback ke req.protocol+host), TAPI wajib diisi di production
# (mis. https://sewalog-backend.onrender.com) kalau TOKO_PUBLIC_HOST kosong,
# supaya OG tags-nya benar walau app.set('trust proxy') sudah ada.
PUBLIC_BASE_URL=

# Custom domain khusus halaman publik Etalase Online, TANPA https:// dan
# TANPA path (mis. toko.sewalog.com) — begitu diisi, GET /{slug} di root
# domain ini (bukan /toko/{slug}) langsung melayani halaman publik, dan
# semua canonical/og:url memakai bentuk https://{TOKO_PUBLIC_HOST}/{slug}.
# Custom domain ini disambungkan ke Web Service backend yang sama di Render
# (Settings > Custom Domains) — lihat README bagian Deploy. Kosongkan di
# dev lokal; /toko/{slug} tetap selalu jalan sebagai fallback apapun
# isinya (dipakai vendor/tim lewat URL backend biasa kalau custom domain
# ini belum/tidak disambungkan).
TOKO_PUBLIC_HOST=

# Cloudflare R2 (S3-compatible) — dipakai buat upload foto alat.
# Beda dari Supabase, R2 tidak punya RLS per-user, jadi kredensial ini
# HARUS tetap di backend, tidak boleh dikirim ke frontend sama sekali.
# R2_ACCOUNT_ID     : Cloudflare dashboard > R2 > Account ID
# R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY : R2 > Manage API Tokens > Create API Token
# R2_BUCKET_NAME    : nama bucket yang dibuat di R2
# R2_PUBLIC_URL     : domain publik bucket (custom domain, atau URL r2.dev bawaan) — TANPA trailing slash
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Opsional — kredensial akun demo yang direset oleh tombol "Reset Data Demo"
# di layar login (routes/demo.ts) dan `npm run seed:demo`. Boleh dibiarkan
# kosong, defaultnya sudah cocok satu sama lain di kedua tempat itu.
# DEMO_OWNER_EMAIL=demo.pemilik@sewalog.test
# DEMO_KARYAWAN_EMAIL=demo.karyawan@sewalog.test
# DEMO_PASSWORD=CobaSewalog2026
