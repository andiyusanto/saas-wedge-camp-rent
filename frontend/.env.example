VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:3001

# Opsional — domain publik Etalase Online kalau custom domain
# toko.sewalog.com sudah disambungkan ke backend (lihat README bagian
# Deploy langkah 8, dan TOKO_PUBLIC_HOST di backend/.env.example — dua env
# var ini HARUS konsisten). Kosongkan di dev lokal, fallback ke
# {VITE_API_BASE_URL}/toko.
VITE_TOKO_PUBLIC_BASE_URL=

# Nomor WhatsApp support Sewalog (bukan nomor vendor) — dipakai tombol
# "Kirim Masukan/Keluhan" (Panduan) dan "Tertarik? Kasih Tahu Kami" (Toko
# Online fake-door). Boleh format lokal (08xx) atau internasional (62xx).
# Nomor yang sama juga harus diisi di landing/.env.example.
VITE_SUPPORT_WHATSAPP_NUMBER=
