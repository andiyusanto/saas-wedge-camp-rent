# URL app produk (frontend/) — dipakai tombol "Buka Demo" di bagian Coba
# Akun Demo. Kalau kosong, fallback ke http://localhost:5173 (dev lokal).
VITE_APP_URL=

# Nomor WhatsApp support Sewalog — dipakai CTA utama landing page (wa.me
# link) dan teks "WhatsApp: ..." di footer. Juga mengisi nomor WA di
# public/blog/*.html saat `npm run build` (placeholder 62xxxxxxxxxx diganti
# lewat plugin di vite.config.ts) — kalau kosong, blog tetap placeholder.
# Boleh format lokal (08xx) atau
# internasional (62xx). Nomor yang sama juga harus diisi di
# frontend/.env.example (VITE_SUPPORT_WHATSAPP_NUMBER).
VITE_SUPPORT_WHATSAPP_NUMBER=
